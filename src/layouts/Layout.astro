<style is:global>
	:root {
		--bg: #0f0f0f;
		--text: #f0f0f0;
		--text-dim: #9a9a9a;
		--accent: #ff6b35;
		--border: #2a2a2a;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: 'Inter', -apple-system, system-ui, sans-serif;
		font-size: 18px;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
	}

	h1, h2, h3 {
		font-family: 'Space Grotesk', 'Inter', sans-serif;
		font-weight: 700;
		line-height: 1.1;
		margin: 0;
	}

	h1 {
		font-size: clamp(4rem, 12vw, 10rem);
		letter-spacing: -0.04em;
	}

	h2 {
		font-size: clamp(2.5rem, 6vw, 5rem);
		letter-spacing: -0.03em;
	}

	h3 {
		font-size: 1.5rem;
		letter-spacing: -0.02em;
	}

	p, ul {
		margin: 0;
	}

	ul {
		padding: 0;
		list-style: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		color: var(--accent);
	}

	.page-shell {
		max-width: 1600px;
		margin: 0 auto;
	}

	.section-grid {
		padding: 0 3rem 12rem;
	}

	.section-card {
		margin-bottom: 12rem;
		/* Keep headings clear of the fixed nav when jumping to #anchors */
		scroll-margin-top: 7rem;
	}

	/* Last section relies on .section-grid's bottom padding, so the gap before the footer isn't doubled */
	.section-card:last-child {
		margin-bottom: 0;
	}

	.section-card h2 {
		margin-bottom: 4rem;
	}

	.section-card > p {
		max-width: 70ch;
		margin-bottom: 1.5rem;
		color: var(--text-dim);
	}

	@media (max-width: 768px) {
		body {
			font-size: 17px;
		}

		.section-grid {
			padding: 0 2rem 8rem;
		}

		.section-card {
			margin-bottom: 8rem;
		}
	}
</style>
